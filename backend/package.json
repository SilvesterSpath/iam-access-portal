{
  "name": "access-provisioning-portal-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "node --experimental-require-module ./node_modules/prisma/build/index.js generate",
    "prisma:migrate": "node --experimental-require-module ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:seed": "node --experimental-require-module ./node_modules/prisma/build/index.js db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.9.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
